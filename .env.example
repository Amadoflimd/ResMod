# ResMod environment configuration
# Copy this file to .env and fill in the values you need.

# Server port
PORT=3000

# Google Sign-In (optional). Set to true to enable the sign-in button.
ENABLE_GOOGLE_SIGNIN=false

# Google OAuth 2.0 credentials from the Google Cloud Console.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Secret used to sign session cookies. Generate a long random string.
SESSION_SECRET=change_this_to_a_random_string
